{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddk.dev/schemas/cycle.schema.json",
  "title": "SDDK Cycle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "workspace_id",
    "cycle_id",
    "display_name",
    "status",
    "phase",
    "path",
    "branch",
    "base"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]+/[a-z][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "BLOCKED", "REMEDIATING", "RELEASE_PENDING", "RELEASED", "CLOSED", "ABANDONED", "RECOVERING"]
    },
    "phase": {
      "type": "string",
      "enum": ["explore", "specify", "design", "plan", "build", "verify", "review", "release", "archive"]
    },
    "path": {
      "type": "string",
      "enum": ["A-min", "A-lite", "A-full", "B-direct"]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "artifact-ref.schema.json"
      }
    },
    "release": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Release"
        }
      ]
    },
    "remediation_round": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "remote_url": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  },
  "$defs": {
    "Release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
